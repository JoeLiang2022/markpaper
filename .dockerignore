# Keep the web-service image lean and the build context small.
.git
.gitignore

# Generated build artifacts
*.pdf
*.aux
*.log
*.out
*.toc
*.bak
paper.tex
paper.tmp.md
paper.mermaid.tmp.md
cover_page.tmp.tex
.tags
ref_list.md
toc_list.md

# Generated Mermaid images (rendered on demand at runtime)
images/mermaid-*.png

# Translation output directories
translated-*/
zh_tw/
zh-tw/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store

# Local secrets (never bake into the image)
.api_key
